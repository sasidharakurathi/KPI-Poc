# Copy this file to .env and fill in your paths.

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed

# ── Model paths ──────────────────────────────────────────────────────────────
FIRE_SMOKE_MODEL_PATH=./app/models/fire-smoke.pt
MOBILE_PERSON_MODEL_PATH=./app/models/mobile-person-usage.pt
MOBILE_PHONE_MODEL_PATH=./app/models/mobile-phone-usage.pt

# ── Device ───────────────────────────────────────────────────────────────────
# "cuda:0" (default when GPU is present) or "cpu"
DEVICE=cuda:0
# FP16 half-precision on GPU — ~2× faster, negligible accuracy difference
USE_HALF=true

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Number of KPIs to run in parallel (set lower on memory-constrained machines)
MAX_WORKERS=4
