# Copy this file to .env and fill in your paths.

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=storage/uploads
# Per-detection 8-frame clip windows are written here
ALERTS_DIR=storage/alerts

# Number of raw frames saved per detection: BEFORE + anchor + AFTER (default 8)
ALERT_WINDOW_BEFORE=4
ALERT_WINDOW_AFTER=3

# ── Model paths ──────────────────────────────────────────────────────────────
# Optional override — per-KPI model paths otherwise come from config.json
FIRE_SMOKE_MODEL_PATH=./app/models/fire-smoke.pt

# ── Device ───────────────────────────────────────────────────────────────────
# "cuda:0" for Nvidia GPUs or "cpu"
DEVICE=cuda:0
USE_HALF=true

# Developer mode: also save labeled copies of each detection clip frame
# (raw frames are always saved).
DEV_MODE=true

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Number of KPIs to run in parallel.
#
# On GPU: keep this at 1.
# On CPU: raise this to use multiple cores — each worker's intra-op thread
# count is auto-computed as cpu_count // MAX_WORKERS (at app/__init__.py).
MAX_WORKERS=1

# ── IP camera recording ──────────────────────────────────────────────────────
# Length of each recorded clip before it's rolled over and queued for KPI
# processing (default 120s).
STREAM_CLIP_SECONDS=120

# Keep every other captured frame (halving both frame count and declared fps,
# so clip duration is unchanged) to cut KPI processing time roughly in half
# at the cost of detection recall. Set to false to record at the camera's
# original fps.
STREAM_FRAME_THINNING_ENABLED=true

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/visionai

# ── Email alerts ─────────────────────────────────────────────────────────────
# Encrypts the SMTP password before storing it in the DB. Generate one per
# deployment — do not reuse this value or commit a real key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=
